	"item": [
		{
			"name": "get book by id",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "https://rahulshettyacademy.com/Library/GetBook.php?ID={{newId}}",
					"protocol": "https",
					"host": [
						"rahulshettyacademy",
						"com"
					],
					"path": [
						"Library",
						"GetBook.php"
					],
					"query": [
						{
							"key": "ID",
							"value": "{{newId}}"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "post book",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"let newColor =pm.variables.replaceIn('{{$randomColor}}')\r",
							"let newMonth = pm.variables.replaceIn('{{$randomMonth}}')\r",
							"\r",
							"let newIsbnNum = pm.variables.replaceIn('{{$randomInt}}')\r",
							"let newAisleNum = pm.variables.replaceIn('{{$randomInt}}')\r",
							"\r",
							"let firstName = pm.variables.replaceIn('{{$randomFirstName}}')\r",
							"let lastName = pm.variables.replaceIn('{{$randomLastName}}')\r",
							"\r",
							"\r",
							"pm.collectionVariables.set(\"newBookName\",newColor+\" \" +newMonth)\r",
							"pm.collectionVariables.set(\"newIsbnNum\",newIsbnNum *8)\r",
							"pm.collectionVariables.set(\"newAisleNum\",newAisleNum *8)\r",
							"pm.collectionVariables.set(\"fullNameAuthor\",firstName +\" \"+lastName )\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"let myResponse  = pm.response.json()\r",
							"\r",
							"let myId = myResponse.ID\r",
							"\r",
							"pm.collectionVariables.set(\"newId\",myId)\r",
							"\r",
							"pm.test(\"this is to test\",function(){\r",
							"    pm.response.to.have.status(200)\r",
							"})"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n\"name\":\"{{newBookName}}\",\r\n\"isbn\":\"{{newIsbnNum}}\",\r\n\"aisle\":\"{{newAisleNum}}\",\r\n\"author\":\"{{fullNameAuthor}}\"\r\n}\r\n",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "https://rahulshettyacademy.com/Library/Addbook.php",
					"protocol": "https",
					"host": [
						"rahulshettyacademy",
						"com"
					],
					"path": [
						"Library",
						"Addbook.php"
					]
				}
			},
			"response": []
